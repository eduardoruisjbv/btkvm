[Unit]
Description=AirPlay receiver (shairport-sync) in the user session
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
# Wait for nqptp (system service) to listen; without it shairport falls back to AirPlay 1 (port 5000).
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do ss -Hlun "sport = :319" | grep -q . && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/bin/shairport-sync -c %h/.config/shairport-sync/shairport-sync.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
