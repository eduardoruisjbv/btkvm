#!/usr/bin/env python3
"""Print the latest dual telemetry without accessing root sockets."""
import json
import sys
import time
from pathlib import Path

try:
    stats = json.loads(Path("/run/btkvm-dual.json").read_text())
except (OSError, ValueError):
    sys.exit("Telemetria dual indisponível. Veja modo=dual em /etc/btkvm.conf e journalctl -u btkvm.")
age = time.monotonic() - stats.get("updated_monotonic", 0)
stats["report_age_s"] = round(age, 1)
stats["stale"] = age < 0 or age > 15
print(json.dumps(stats, indent=2, ensure_ascii=False))
