#!/usr/bin/env bash
# Make the PC discoverable for 3 minutes so the Mac can pair with it as a keyboard/mouse.
nome="$(bluetoothctl show | sed -n 's/^[[:space:]]*Name: //p' | head -1)"
bluetoothctl pairable on >/dev/null
bluetoothctl discoverable-timeout 180 >/dev/null
bluetoothctl discoverable on >/dev/null
echo "PC discoverable for 3 minutes. On the Mac: System Settings > Bluetooth > '${nome:-this PC}' > Connect."
echo "If a code appears on either device, confirm it."
