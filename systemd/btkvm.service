[Unit]
Description=btkvm — PC keyboard and mouse on the Mac over Bluetooth (Super+K)
After=bluetooth.service
Requires=bluetooth.service
PartOf=bluetooth.service
StartLimitIntervalSec=0

[Service]
# Graphical session user (filled in by the installer).
Environment=BTKVM_USER=@USUARIO@
ExecStart=/usr/bin/python3 /usr/local/bin/btkvm
Restart=always
RestartSec=2

[Install]
WantedBy=bluetooth.target
