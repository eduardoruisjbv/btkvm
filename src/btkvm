#!/usr/bin/env python3
"""btkvm — the PC becomes the Mac's Bluetooth keyboard and mouse.

Super+K switches keyboard and mouse input from the PC to the Mac; press it
again to return input to the PC.

Runs as root (systemd service btkvm.service): requires L2CAP ports 17/19 (HID)
and exclusive access (EVIOCGRAB) to devices in /dev/input.
"""
import collections
import fcntl
import os
import pwd
import select
import socket
import struct
import subprocess
import sys
import threading
import time

import dbus
import dbus.mainloop.glib
import dbus.service
import evdev
from evdev import ecodes as e
from gi.repository import GLib

# Graphical session user (used to access the session D-Bus). Set BTKVM_USER
# in the service; otherwise the owner of the active loginctl session is used.
def _usuario():
    nome = os.environ.get("BTKVM_USER")
    if not nome:
        saida = subprocess.run(["loginctl", "list-sessions", "--no-legend"],
                               capture_output=True, text=True).stdout
        for linha in saida.splitlines():
            campos = linha.split()
            if len(campos) >= 3 and int(campos[1]) >= 1000:
                nome = campos[2]
                break
    return nome or pwd.getpwuid(1000).pw_name


USUARIO = _usuario()
UID = pwd.getpwnam(USUARIO).pw_uid
ARQ_HOST = "/var/lib/btkvm/host"  # Mac address, saved on the first connection
PSM_CTRL, PSM_INTR = 17, 19
MOUSE_INTERVALO = 0.008  # ~125 Hz: Bluetooth cannot sustain a 1000 Hz mouse

