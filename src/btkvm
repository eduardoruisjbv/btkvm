def log(msg):
    print(msg, flush=True)


def avisar(msg):
    subprocess.Popen(
        ["runuser", "-u", USUARIO, "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{UID}/bus",
         "notify-send", "-a", "KVM", "-i", "input-keyboard", "-t", "1500", "KVM", msg],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ------------------------------------------------------------ perfil no BlueZ
class Perfil(dbus.service.Object):
    @dbus.service.method("org.bluez.Profile1", in_signature="", out_signature="")
    def Release(self):
        pass

    @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}", out_signature="")
    def NewConnection(self, caminho, fd, props):
        os.close(fd.take())

    @dbus.service.method("org.bluez.Profile1", in_signature="o", out_signature="")
    def RequestDisconnection(self, caminho):
        pass


def registrar_perfil(dual=None):
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    barramento = dbus.SystemBus()
    perfil = Perfil(barramento, "/org/btkvm/perfil")
    gerente = dbus.Interface(barramento.get_object("org.bluez", "/org/bluez"), "org.bluez.ProfileManager1")
    gerente.RegisterProfile(perfil, "00001124-0000-1000-8000-00805f9b34fb", {
        "ServiceRecord": REGISTRO_SDP, "Role": "server",
        "RequireAuthentication": True, "RequireAuthorization": False,
    })
    if dual:
        from btkvm_dual.bluez import register
        # Hold exported D-Bus objects for the daemon lifetime.
        registrar_perfil.dual_profile = register(barramento, gerente, dual, ARQ_HOST, log)
    threading.Thread(target=GLib.MainLoop().run, daemon=True).start()
    log("HID profile registered with BlueZ")


def preparar_intr(s):
    # Use a minimal nonblocking send buffer: with the default buffer (hundreds of packets), a slow
    # Bluetooth link accumulated seconds of stale mouse movements that arrived late.
    s.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 1)  # the kernel rounds up to its minimum
    s.setblocking(False)


def socket_l2cap():
    s = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_SEQPACKET, socket.BTPROTO_L2CAP)
    # BT_SECURITY = MEDIUM: accept only the paired Mac over an encrypted link
    s.setsockopt(274, 4, struct.pack("BB", 2, 0))
    return s


# ------------------------------------------------- link control (HCI)
class LinkHCI:
    """Socket HCI cru: observa as trocas de modo do link (ativo/sniff) e liga/desliga o sniff."""
    HCIGETCONNINFO = 0x800448D5
    MODO_MUDOU = 0x14
    POLITICA_SEM_SNIFF = 0x0001   # role switch only
    POLITICA_PADRAO = 0x0005      # role switch + sniff

    @staticmethod
    def achar_adaptador():
        """Index of the first hciN (the adapter may reappear as hci1 after a kernel reset)."""
        import glob, re
        idx = sorted(int(m.group(1)) for c in glob.glob("/sys/class/bluetooth/hci*")
                     if (m := re.fullmatch(r".*/hci(\d+)", c)))
        return idx[0] if idx else 0

    def __init__(self, dev=None):
        if dev is None:
            dev = self.achar_adaptador()
        self.sock = socket.socket(socket.AF_BLUETOOTH, socket.SOCK_RAW, socket.BTPROTO_HCI)
        self.sock.bind((dev,))
        # Filter: event packets only (type 4), and only the "Mode Change" event (0x14)
        filtro = struct.pack("<IIIH2x", 1 << 4, 1 << self.MODO_MUDOU, 0, 0)
        self.sock.setsockopt(0, 2, filtro)  # SOL_HCI, HCI_FILTER

    def handle(self, endereco):
        bd = bytes(int(x, 16) for x in reversed(endereco.split(":")))
        buf = bytearray(bd + b"\x01" + bytes(1 + 16))  # ACL_LINK; conn_info starts at offset 8
        try:
            fcntl.ioctl(self.sock.fileno(), self.HCIGETCONNINFO, buf)
        except OSError:
            return None
        return struct.unpack_from("<H", buf, 8)[0]

    def comando(self, ocf, params):
        opcode = (0x02 << 10) | ocf  # OGF 0x02 = Link Policy
        self.sock.send(struct.pack("<BHB", 1, opcode, len(params)) + params)

    def sem_sniff(self, endereco, desligar):
        h = self.handle(endereco)
        if h is None:
            return
        politica = self.POLITICA_SEM_SNIFF if desligar else self.POLITICA_PADRAO
        self.comando(0x000D, struct.pack("<HH", h, politica))  # Write_Link_Policy_Settings
        if desligar:
            self.comando(0x0004, struct.pack("<H", h))         # Exit_Sniff_Mode
        log(f"link {h:#x}: sniff {'disabled' if desligar else 'enabled'}")

    def ler(self):
        dados = self.sock.recv(64)
        if len(dados) >= 9 and dados[0] == 4 and dados[1] == self.MODO_MUDOU:
            status, h, modo, intervalo = struct.unpack_from("<BHBH", dados, 3)
            nome = {0: "active", 1: "hold", 2: "sniff"}.get(modo, str(modo))
            log(f"link {h:#x}: mode {nome}" + (f", intervalo {intervalo * 0.625:.1f} ms" if modo else "")
                + (f" (status {status:#x})" if status else ""))


# ------------------------------------------------------------------ service
class KVM:
    def __init__(self, dual=None):
        self.dual = dual
        self.dual_mode = "INACTIVE"
        self.dual_epoch = 0
        self.dual_ready = False
        self.dual_pending = False
        self.dual_totals = [0, 0, 0, 0]
        self.dual_sample = 0
        self.dispositivos = {}  # fd -> InputDevice
        self.ultima_varredura = 0
        self.pressionadas = set()
        self.ativo = False          # entrada indo para o Mac
        self.esperando_soltar = False
        self.ctrl = self.intr = None
        self.dx = self.dy = self.roda = self.rodah = 0
        self.roda_hr = self.rodah_hr = 0  # wheel in 1/120-click units (high resolution)
        self.botoes = 0
        self.mouse_pendente = False
        self.ultimo_mouse = 0.0
        self.fila = collections.deque()  # keys/buttons that did not fit in the buffer: never discarded
        self.ouvir_ctrl = self._ouvir(PSM_CTRL)
        self.ouvir_intr = self._ouvir(PSM_INTR)
        self.hci = LinkHCI()
        self.host = None
        if dual:
            try:
                with open(ARQ_HOST) as source:
                    self.host = source.read().strip() or None
            except OSError:
                pass
        self.envios = self.cheios = 0  # mouse statistics, written to the log
        self.ultima_estatistica = 0.0

    @staticmethod
    def _ouvir(psm):
        s = socket_l2cap()
        s.bind((socket.BDADDR_ANY, psm))
        s.listen(1)
        return s

    # ---- dispositivos de entrada
    def varrer(self):
        self.ultima_varredura = time.monotonic()
        conhecidos = {d.path for d in self.dispositivos.values()}
        for caminho in evdev.list_devices():
            if caminho in conhecidos:
                continue
            try:
                d = evdev.InputDevice(caminho)
                cap = d.capabilities()
            except OSError:
                continue
            if e.KEY_A in cap.get(e.EV_KEY, []) or e.REL_X in cap.get(e.EV_REL, []):
                self.dispositivos[d.fd] = d
                log(f"dispositivo: {d.path} {d.name}")
                if self.ativo:
                    self._agarrar(d)
            else:
                d.close()

    @staticmethod
    def _agarrar(d):
        try:
            d.grab()
        except OSError:
            pass

    @staticmethod
    def _soltar(d):
        try:
            d.ungrab()
        except OSError:
            pass

    def remover(self, fd):
        d = self.dispositivos.pop(fd, None)
        if d:
            log(f"device removed: {d.path}")
            try:
                d.close()
            except OSError:
                pass
            self.pressionadas = set()
            if self.dual and self.ativo:
                self.desativar("Input device removed — input returned to the PC")

    # ---- Bluetooth connection
    @property
    def conectado(self):
        return self.ctrl is not None and self.intr is not None

    def desconectar(self, motivo):
        for s in (self.ctrl, self.intr):
            if s:
                try:
                    s.close()
                except OSError:
                    pass
        self.ctrl = self.intr = None
        self.fila.clear()
        log(f"disconnected: {motivo}")
        if self.ativo and (not self.dual or self.dual_mode != "AGENT"):
            self.desativar("Mac disconnected — keyboard and mouse returned to the PC")

    def conectar(self):
        try:
            host = open(ARQ_HOST).read().strip()
        except OSError:
            avisar("Mac is not paired yet — run: btkvm-parear")
            return False
        try:
            c = socket_l2cap()
            c.settimeout(6)
            c.connect((host, PSM_CTRL))
            i = socket_l2cap()
            i.settimeout(6)
            i.connect((host, PSM_INTR))
        except OSError as erro:
            log(f"failed to connect to {host}: {erro}")
            avisar("Could not connect to the Mac (is Bluetooth enabled on the Mac?)")
            return False
        c.settimeout(None)
        preparar_intr(i)
        self.ctrl, self.intr = c, i
        self.host = host
        log(f"connected to {host}")
        return True

    def aceitar(self, ouvinte):
        s, info = ouvinte.accept()
        endereco = info[0]
        try:
            registrado = open(ARQ_HOST).read().strip()
        except OSError:
            registrado = ""
        # Accept only the registered host: phones and other paired devices can also open the
        # HID ports and previously overwrote the Mac address.
        if registrado and endereco.upper() != registrado.upper():
            log(f"rejected {endereco}: keyboard/mouse belongs to host {registrado} "
                f"(to change hosts, remove {ARQ_HOST} and pair again)")
            s.close()
            return
        if ouvinte is self.ouvir_ctrl:
            if self.ctrl:
                self.ctrl.close()
            self.ctrl = s
        else:
            if self.intr:
                self.intr.close()
            preparar_intr(s)
            self.intr = s
        self.host = endereco
        os.makedirs(os.path.dirname(ARQ_HOST), exist_ok=True)
        with open(ARQ_HOST, "w") as f:
            f.write(endereco + "\n")
        log(f"Mac {endereco} connected ({'ctrl' if ouvinte is self.ouvir_ctrl else 'intr'})")

    def controle(self):
        try:
            dados = self.ctrl.recv(64)
        except OSError:
            dados = b""
        if not dados:
            self.desconectar("canal de controle fechado")
            return
        tipo, param = dados[0] >> 4, dados[0] & 0x0F
        if tipo == 0x1:
            if param == 0x5:  # VIRTUAL_CABLE_UNPLUG
                self.desconectar("Mac removeu o teclado")
            return
        resposta = {
            0x4: b"\xa1\x01" + bytes(8),     # GET_REPORT: teclado vazio
            0x6: b"\xa0\x01",                # GET_PROTOCOL: report protocol
            0x8: b"\xa0\x00",                # GET_IDLE
        }.get(tipo, b"\x00")                  # demais: HANDSHAKE sucesso
        try:
            self.ctrl.send(resposta)
        except OSError:
            pass

    def interrupcao(self):
        try:
            dados = self.intr.recv(64)  # LEDs do teclado vindos do Mac: ignorados
        except (socket.timeout, BlockingIOError):
            return
        except OSError:
            dados = b""
        if not dados:
            self.desconectar("interrupt channel closed")

    def _mandar(self, relatorio):
        """True if sent (or if there is nowhere to send); False if the buffer is full."""
        if not self.intr:
            return True
        try:
            self.intr.send(b"\xa1" + relatorio)
        except BlockingIOError:
            return False
        except OSError:
            self.desconectar("erro ao enviar")
        return True

    def esvaziar_fila(self):
        while self.fila:
            relatorio = self.fila[0]
            if not self._mandar(relatorio):
                break
            if self.fila and self.fila[0] is relatorio:  # desconectar() pode ter limpado a fila
                self.fila.popleft()

    def enviar(self, relatorio, importante=True):
        """Important reports (keys, buttons) are queued and sent in order.
        Mouse movement is nonessential: if it does not fit, return False and add it to the next report."""
        if importante:
            self.fila.append(relatorio)
            self.esvaziar_fila()
            return True
        self.esvaziar_fila()
        return not self.fila and self._mandar(relatorio)

    # ---- reports
    def enviar_teclado(self):
        mods = 0
        teclas = []
        for codigo in self.pressionadas:
            if codigo in MODIFICADORES:
                mods |= MODIFICADORES[codigo]
            elif codigo in TECLAS and len(teclas) < 6:
                teclas.append(TECLAS[codigo])
        self.enviar(bytes([1, mods, 0] + teclas + [0] * (6 - len(teclas))))

    def enviar_mouse(self, importante=False):
        def corta(v, lim):
            return max(-lim, min(lim, v))
        dx, dy = corta(self.dx, 32767), corta(self.dy, 32767)
        r, rh = corta(self.roda, 127), corta(self.rodah, 127)
        if not self.enviar(struct.pack("<BBhhbb", 2, self.botoes, dx, dy, r, rh), importante):
            # buffer cheio: o movimento fica acumulado e tenta de novo em 2 ms
            self.ultimo_mouse = time.monotonic() - MOUSE_INTERVALO + 0.002
            self.cheios += 1
            return
        self.envios += 1
        self.dx -= dx
        self.dy -= dy
        self.roda -= r
        self.rodah -= rh
        self.mouse_pendente = bool(self.dx or self.dy or self.roda or self.rodah)
        self.ultimo_mouse = time.monotonic()

    def zerar_mac(self):
        self.botoes = 0
        self.dx = self.dy = self.roda = self.rodah = 0
        self.roda_hr = self.rodah_hr = 0
        self.mouse_pendente = False
        self.fila.clear()
        self.enviar(bytes([1] + [0] * 8))
        self.enviar(struct.pack("<BBhhbb", 2, 0, 0, 0, 0, 0))
        self.enviar(b"\x03\x00\x00")

    # ---- alternância
    def ativar(self):
        if self.dual:
            self.esperando_soltar = True
            return
        if not self.conectado and not self.conectar():
            return
        # grab only after Super and K are released, otherwise GNOME may keep Super "stuck"
        self.esperando_soltar = True

    def _agarrar_tudo(self):
        self.esperando_soltar = False
        self.ativo = True
        self.pressionadas = set()
        for d in self.dispositivos.values():
            self._agarrar(d)
        self.zerar_mac()
        if self.dual:
            self.dual_ready = self.dual_pending = False
            self.dual_totals = [0, 0, 0, 0]
            self.dual_sample = 0
            self.dual_mode = "NEGOTIATING"
            self.dual.activate()
        if self.host:
            self.hci.sem_sniff(self.host, True)
        avisar("Keyboard and mouse are on the Mac")
        log("active: input is routed to the Mac")

    def desativar(self, msg="Keyboard and mouse returned to the PC"):
        if self.dual:
            self.dual.deactivate()
            self.dual_mode = "INACTIVE"
            self.dual_ready = self.dual_pending = False
        self.zerar_mac()
        self.ativo = False
        self.esperando_soltar = False
        for d in self.dispositivos.values():
            self._soltar(d)
        self.pressionadas = set()
        if self.host and (self.conectado or self.dual):
            self.hci.sem_sniff(self.host, False)
        avisar(msg)
        log("inactive: input is routed to the PC")

    # ---- dual mode (opt-in): the HID path above remains the default
    def _dual_usage(self, codigo):
        if codigo in MODIFICADORES:
            return 0x0700 | (0xE0 + MODIFICADORES[codigo].bit_length() - 1)
        if codigo in TECLAS:
            return 0x0700 | TECLAS[codigo]
        if codigo in MIDIA:
            return 0x0C00 | MIDIA[codigo]
        if codigo in BOTOES:
            return 0x0900 | BOTOES[codigo].bit_length()
        return None

    def _dual_mouse(self):
        from btkvm_dual.protocol import MouseState, monotonic_us
        return MouseState(self.dual_sample, self.dual_epoch, *self.dual_totals, monotonic_us())

    def _dual_notices(self):
        for notice in self.dual.drain_notices():
            if notice.kind == "fatal":
                log(f"dual: runtime failure: {notice.value}")
                self.desativar("Dual mode failed — input returned to the PC")
            elif notice.kind == "mode":
                change = notice.value
                log(f"dual: {change.old.name} → {change.new.name}, epoch {change.epoch}: {change.reason}")
                if not self.ativo:
                    continue
                self.dual_epoch = change.epoch
                self.dual_ready = self.dual_pending = False
                self.dual_mode = change.new.name
                if change.new.name == "AGENT":
                    # Releases must drain before ready(): the Mac waits for the
                    # resulting SNAPSHOT before enabling its agent writer.
                    self.zerar_mac()
                    self.dual_pending = True
                elif change.new.name == "HID":
                    if not self.conectado:
                        # Restore PC input before a potentially slow HID connect.
                        self.desativar("Agent unavailable — connecting HID")
                        if self.conectar():
                            avisar("HID connected — press Super+K to try again")
                        continue
                    self.zerar_mac()
                    self.botoes = sum(BOTOES[c] for c in self.pressionadas if c in BOTOES)
                    self.enviar_teclado()
                    self.enviar_mouse(importante=True)
                    media = next((MIDIA[c] for c in self.pressionadas if c in MIDIA), 0)
                    self.enviar(struct.pack("<BH", 3, media))
                    avisar("Keyboard and mouse are on the Mac via HID")
            elif notice.kind == "telemetry":
                log("dual 5s: " + str(notice.value))
            elif notice.kind in ("link_lost", "session_ready"):
                log(f"dual: {notice.kind}: {notice.value}")
        if self.dual_pending and not self.fila and self.ativo:
            usages = {self._dual_usage(c) for c in self.pressionadas}
            usages.discard(None)
            self.dual.ready(self.dual_epoch, usages, self._dual_mouse())
            self.dual_pending = False
            self.dual_ready = True
            avisar("Keyboard and mouse are on the Mac via LAN + Bluetooth")

    def _dual_relative(self, ev, disp):
        index = {e.REL_X: 0, e.REL_Y: 1, e.REL_WHEEL_HI_RES: 2,
                 e.REL_HWHEEL_HI_RES: 3, e.REL_WHEEL: 2, e.REL_HWHEEL: 3}.get(ev.code)
        if index is None:
            return
        value = ev.value
        if ev.code in (e.REL_WHEEL, e.REL_HWHEEL):
            high = e.REL_WHEEL_HI_RES if ev.code == e.REL_WHEEL else e.REL_HWHEEL_HI_RES
            if disp is not None and high in disp.capabilities().get(e.EV_REL, []):
                return
            value *= 120
        self.dual_totals[index] = ((self.dual_totals[index] + value + 0x80000000) & 0xFFFFFFFF) - 0x80000000
        self.dual_sample = (self.dual_sample + 1) & 0xFFFFFFFF
        if self.dual_mode == "AGENT" and self.dual_ready:
            self.dual.send_mouse(self._dual_mouse())

    def evento(self, ev, disp=None):
        if ev.type == e.EV_KEY:
            codigo, valor = ev.code, ev.value
            if valor == 2:  # repeat: the Mac handles its own
                return
            if valor:
                self.pressionadas.add(codigo)
            else:
                self.pressionadas.discard(codigo)

            if codigo == e.KEY_K and valor == 1 and any(m in self.pressionadas for m in META):
                self.pressionadas.discard(e.KEY_K)
                if self.ativo:
                    self.desativar()
                elif not self.esperando_soltar:
                    self.ativar()
                return
            if not self.ativo:
                return
            if self.dual and self.dual_mode != "HID":
                if self.dual_mode == "AGENT" and self.dual_ready:
                    usage = self._dual_usage(codigo)
                    if usage is not None:
                        from btkvm_dual.protocol import KeyTransition
                        self.dual.send_transition(self.dual_epoch, KeyTransition(
                            usage, bool(valor), *self.dual_totals[:2], self.dual_sample))
                return
            if codigo in BOTOES:
                if valor:
                    self.botoes |= BOTOES[codigo]
                else:
                    self.botoes &= ~BOTOES[codigo]
                self.enviar_mouse(importante=True)
            elif codigo in MIDIA:
                self.enviar(struct.pack("<BH", 3, MIDIA[codigo] if valor else 0))
            elif codigo in MODIFICADORES or codigo in TECLAS:
                self.enviar_teclado()
        elif ev.type == e.EV_REL and self.ativo:
            if self.dual:
                self._dual_relative(ev, disp)
                if self.dual_mode != "HID":
                    return
            if ev.code == e.REL_X:
                self.dx += ev.value
            elif ev.code == e.REL_Y:
                self.dy += ev.value
            elif ev.code in (e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES):
                # layers such as OpenLogi emit only HI_RES (120 = 1 click)
                if ev.code == e.REL_WHEEL_HI_RES:
                    self.roda_hr += ev.value
                    n = int(self.roda_hr / 120)
                    self.roda_hr -= n * 120
                    self.roda += n
                else:
                    self.rodah_hr += ev.value
                    n = int(self.rodah_hr / 120)
                    self.rodah_hr -= n * 120
                    self.rodah += n
                if not n:
                    return
            elif ev.code in (e.REL_WHEEL, e.REL_HWHEEL):
                # use only on devices without HI_RES to avoid double counting
                if disp is not None and e.REL_WHEEL_HI_RES in disp.capabilities().get(e.EV_REL, []):
                    return
                if ev.code == e.REL_WHEEL:
                    self.roda += ev.value
                else:
                    self.rodah += ev.value
            else:
                return
            self.mouse_pendente = True

    def rodar(self):
        self.varrer()
        while True:
            if self.dual:
                self._dual_notices()
            leitura = [self.ouvir_ctrl, self.ouvir_intr, self.hci.sock] + list(self.dispositivos)
            leitura += [s for s in (self.ctrl, self.intr) if s]
            espera = 1.0
            if self.fila:
                espera = 0.002
            elif self.mouse_pendente:
                espera = max(0.0, self.ultimo_mouse + MOUSE_INTERVALO - time.monotonic())
            elif self.esperando_soltar:
                espera = 0.02
            if self.dual:
                espera = min(espera, 0.004)
            prontos, _, _ = select.select(leitura, [], [], espera)

            for obj in prontos:
                if obj is self.ouvir_ctrl or obj is self.ouvir_intr:
                    self.aceitar(obj)
                elif obj is self.hci.sock:
                    self.hci.ler()
                elif obj is self.ctrl:
                    self.controle()
                elif obj is self.intr:
                    self.interrupcao()
                elif obj in self.dispositivos:
                    try:
                        for ev in self.dispositivos[obj].read():
                            self.evento(ev, self.dispositivos[obj])
                    except OSError:
                        self.remover(obj)

            if self.fila:
                self.esvaziar_fila()
            if self.esperando_soltar and not any(d.active_keys() for d in self.dispositivos.values()):
                self._agarrar_tudo()
            if self.mouse_pendente and time.monotonic() - self.ultimo_mouse >= MOUSE_INTERVALO:
                self.enviar_mouse()
            if self.ativo and time.monotonic() - self.ultima_estatistica > 5:
                if self.envios or self.cheios:
                    log(f"mouse 5s: {self.envios} enviados, {self.cheios} adiados por buffer cheio")
                self.envios = self.cheios = 0
                self.ultima_estatistica = time.monotonic()
            if time.monotonic() - self.ultima_varredura > 3:
                self.varrer()


