#!/usr/bin/env python3
"""btkvm — o PC vira um teclado + mouse Bluetooth do Mac.

Super+K alterna: o teclado e o mouse do PC passam a ir para o Mac (o PC
fica "parado") e, no próximo Super+K, voltam para o PC.

Roda como root (serviço systemd btkvm.service): precisa das portas L2CAP 17/19
(HID) e de acesso exclusivo (EVIOCGRAB) aos dispositivos em /dev/input.
"""
import collections
import fcntl
