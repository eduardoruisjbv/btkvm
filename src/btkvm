from gi.repository import GLib

# Usuário da sessão gráfica (usado para falar com o D-Bus de sessão). Defina BTKVM_USER
# no serviço; sem isso, usa o dono da sessão ativa do loginctl.
def _usuario():
    nome = os.environ.get("BTKVM_USER")
    if not nome:
        saida = subprocess.run(["loginctl", "list-sessions", "--no-legend"],
                               capture_output=True, text=True).stdout
        for linha in saida.splitlines():
            campos = linha.split()
            if len(campos) >= 3 and int(campos[1]) >= 1000:
                nome = campos[2]
                break
    return nome or pwd.getpwuid(1000).pw_name


USUARIO = _usuario()
UID = pwd.getpwnam(USUARIO).pw_uid
ARQ_HOST = "/var/lib/btkvm/host"  # endereço do Mac, gravado na 1ª conexão
PSM_CTRL, PSM_INTR = 17, 19
MOUSE_INTERVALO = 0.008  # ~125 Hz: o Bluetooth não aguenta os 1000 Hz do mouse

